#!/bin/bash

set -euxo pipefail

dnf update -y || true
dnf install -y nginx

# Install AWS CLI if it is not already available
if ! command -v aws >/dev/null 2>&1; then
  dnf install -y awscli-2 || true
fi

# Get an IMDSv2 token
TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")

meta() {
  curl -sS \
    -H "X-aws-ec2-metadata-token: $TOKEN" \
    "http://169.254.169.254/latest/meta-data/$1"
}

INSTANCE_ID=$(meta instance-id)
INSTANCE_TYPE=$(meta instance-type)
AVAILABILITY_ZONE=$(meta placement/availability-zone)

DEPLOYED_AT=$(date -u '+%Y-%m-%d %H:%M:%S UTC')

cat > /usr/share/nginx/html/index.html <<HTML
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>${project_name} - provisioned by Terraform</title>

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      font-family: Arial, sans-serif;
      background: #12111a;
      color: #edebf2;
      padding: 24px;
    }

    .card {
      width: 100%;
      max-width: 560px;
      background: #1a1922;
      border-radius: 14px;
      padding: 36px;
    }

    .badge {
      display: inline-block;
      padding: 5px 12px;
      border-radius: 999px;
      margin-bottom: 20px;
      color: #9d8bff;
      border: 1px solid #3b3550;
      text-transform: uppercase;
    }

    h1 {
      margin-top: 0;
    }

    dl {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 10px 20px;
    }

    dt {
      color: #9c97ac;
    }

    dd {
      margin: 0;
      text-align: right;
      word-break: break-all;
    }
  </style>
</head>

<body>
  <main class="card">

    <span class="badge">${environment}</span>

    <h1>${project_name} is live.</h1>

    <p>
      This nginx server was installed automatically using Terraform user data.
    </p>

    <dl>
      <dt>Instance ID</dt>
      <dd>$INSTANCE_ID</dd>

      <dt>Instance Type</dt>
      <dd>$INSTANCE_TYPE</dd>

      <dt>Availability Zone</dt>
      <dd>$AVAILABILITY_ZONE</dd>

      <dt>Region</dt>
      <dd>${aws_region}</dd>

      <dt>S3 Bucket</dt>
      <dd>${s3_bucket_name}</dd>

      <dt>Deployed</dt>
      <dd>$DEPLOYED_AT</dd>
    </dl>

  </main>
</body>
</html>
HTML

systemctl enable nginx
systemctl start nginx

# Copy the landing page to S3 using the EC2 IAM role
aws s3 cp /usr/share/nginx/html/index.html \
  "s3://${s3_bucket_name}/landing-page/index.html" \
  --region "${aws_region}" || echo "S3 upload skipped"